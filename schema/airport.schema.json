{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VATSIM airport stand data",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "airport", "data_status", "reviewed_at", "sources", "stands"],
  "properties": {
    "$schema": { "const": "../schema/airport.schema.json" },
    "schema_version": { "const": 1 },
    "airport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["icao", "name", "country", "latitude", "longitude"],
      "properties": {
        "icao": { "type": "string", "pattern": "^[A-Z]{4}$" },
        "name": { "$ref": "#/definitions/nonemptyString" },
        "country": { "$ref": "#/definitions/nonemptyString" },
        "latitude": { "$ref": "#/definitions/latitude" },
        "longitude": { "$ref": "#/definitions/longitude" }
      }
    },
    "data_status": { "enum": ["unreviewed", "reviewed"] },
    "reviewed_at": { "type": ["string", "null"], "format": "date" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "url", "reference", "effective_date", "accessed_at"],
        "properties": {
          "id": { "$ref": "#/definitions/nonemptyString" },
          "kind": { "enum": ["vacc", "aim", "aip", "import"] },
          "url": { "type": "string", "format": "uri", "pattern": "^https?://" },
          "reference": { "$ref": "#/definitions/nonemptyString" },
          "effective_date": { "type": ["string", "null"], "format": "date" },
          "accessed_at": { "type": "string", "format": "date" }
        }
      }
    },
    "stands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "latitude", "longitude", "max_wingspan_m", "aircraft_code", "approved_aircraft", "prohibited_aircraft", "source_ids"],
        "properties": {
          "id": { "$ref": "#/definitions/nonemptyString" },
          "latitude": { "$ref": "#/definitions/latitude" },
          "longitude": { "$ref": "#/definitions/longitude" },
          "max_wingspan_m": { "type": ["number", "null"], "exclusiveMinimum": 0 },
          "aircraft_code": { "enum": ["A", "B", "C", "D", "E", "F", null] },
          "approved_aircraft": { "$ref": "#/definitions/aircraftTypes" },
          "prohibited_aircraft": { "$ref": "#/definitions/aircraftTypes" },
          "source_ids": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": { "$ref": "#/definitions/nonemptyString" }
          },
          "notes": { "$ref": "#/definitions/nonemptyString" },
          "legacy_aircraft_code": { "$ref": "#/definitions/nonemptyString" }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "data_status": { "const": "reviewed" } } },
      "then": { "properties": { "reviewed_at": { "type": "string", "format": "date" } } },
      "else": { "properties": { "reviewed_at": { "type": "null" } } }
    }
  ],
  "definitions": {
    "nonemptyString": { "type": "string", "minLength": 1, "pattern": "^\\S(?:.*\\S)?$" },
    "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
    "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
    "aircraftTypes": {
      "type": ["array", "null"], "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9]{1,3}$" }
    }
  }
}
